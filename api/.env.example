# Скопируй этот файл в .env и заполни реальными значениями.
# .env не коммитится (см. .gitignore).

# PostgreSQL — единственная поддерживаемая БД.
# Формат: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hackathon
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
TELEGRAM_BOT_USERNAME=
BOT_API_TOKEN=
RAG_ENABLED=false
RAG_SERVICE_TOKEN=
RAG_QDRANT_URL=http://127.0.0.1:6333
RAG_QDRANT_API_KEY=
RAG_COLLECTION=bars_docs_qwen3_v1
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
RAG_EMBEDDING_API_KEY=
RAG_LUNA_BASE_URL=
RAG_LUNA_MODEL=gpt-6-luna
RAG_LUNA_API_KEY=
RAG_MAX_UPLOAD_BYTES=26214400
